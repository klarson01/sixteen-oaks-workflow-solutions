{
  "name": "sixteen-oaks-workflow-solutions",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit && tsc --project tsconfig.functions.json --noEmit",
    "build": "npm run typecheck && node scripts/prepare-assets.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir .build/server && node scripts/prerender.mjs && npm run validate",
    "validate": "node scripts/validate-build.mjs",
    "preview": "vite preview",
    "test": "node tests/run.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.3",
    "@netlify/functions": "^6.0.0",
    "@netlify/identity": "^2.0.0",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-tooltip": "1.1.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "nodemailer": "^10.0.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  },
  "engines": {
    "node": "24.x"
  }
}
